<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\QuickPickerPro-transparent.ico</ApplicationIcon>
    <AssemblyName>QuickPickerPro</AssemblyName>
    <RootNamespace>ValoAutoPick</RootNamespace>
    <Version>1.3.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="agents.json" />
    <EmbeddedResource Include="Assets/QuickPickerPro-transparent.ico" LogicalName="ValoAutoPick.Assets.QuickPickerPro-transparent.ico" />
    <EmbeddedResource Include="Assets/Maps/*.jpg" LogicalName="ValoAutoPick.Assets.Maps.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets/Agents/*.png" LogicalName="ValoAutoPick.Assets.Agents.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets/Agents/*.jpg" LogicalName="ValoAutoPick.Assets.Agents.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
</Project>
